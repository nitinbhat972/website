---
import { Icon } from "astro-icon/components";
import SectionLabel from "../components/SectionLabel.astro";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
    title="404 — Page Not Found"
    description="The page you requested could not be found."
>
    <section class="py-16 sm:py-24">
        <div class="max-w-2xl">
            <SectionLabel text="Error 404" />
            <h1 class="mt-4 text-3xl font-bold tracking-tight text-zinc-100 sm:text-4xl">
                Page not found.
            </h1>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400 sm:text-base">
                The page you requested does not exist or may have moved.
            </p>
            <a
                href="/"
                class="mt-8 inline-flex items-center gap-1.5 font-mono text-xs text-zinc-400 transition-colors hover:text-white"
            >
                <Icon name="lucide:arrow-left" class="size-3.5" />
                <span>back home</span>
            </a>
        </div>
    </section>
</MainLayout>

---
import "../styles/global.css";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Nitin Bhat",
    description = "Computer Engineering graduate focused on systems programming, Linux internals, and minimal developer tools.",
} = Astro.props;

---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <title>{title}</title>
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Blog — Nitin Bhat"
            href="/rss.xml"
        />
        <link rel="sitemap" href="/sitemap-index.xml" />
    </head>

    <body
        class="min-h-screen bg-zinc-950 text-zinc-200 selection:bg-zinc-800 selection:text-zinc-100 flex flex-col"
    >
        <header class="border-b border-zinc-800/70">
            <div class="mx-auto max-w-5xl px-4 sm:px-6">
                <Navigation />
            </div>
        </header>

        <main class="mx-auto max-w-5xl px-4 sm:px-6 py-10 flex-1 w-full">
            <slot />
        </main>

        <Footer />
    </body>
</html>

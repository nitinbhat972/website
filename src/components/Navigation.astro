---
const links = [
    { href: "/", label: "Home" },
    { href: "/blog", label: "Blog" },
];

const pathname = Astro.url.pathname;
---

<nav class="flex items-center gap-6 py-4 font-mono text-sm">
    {
        links.map((link) => {
            const isActive =
                link.href === "/"
                    ? pathname === "/"
                    : pathname.startsWith(link.href);

            return (
                <a
                    href={link.href}
                    class:list={[
                        "transition-colors",
                        isActive
                            ? "text-zinc-100 font-medium"
                            : "text-zinc-500 hover:text-zinc-300",
                    ]}
                >
                    {link.label}
                </a>
            );
        })
    }
</nav>
